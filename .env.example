# =============================================================================
# Stripe Checkout Setup (Umair Altaf marketing portfolio)
# =============================================================================
#
# 1. Create Products and recurring Prices in Stripe Dashboard for monthly packages:
#    - Meta Ads for Service Businesses ($199/mo)
#    - Meta Ads for E-commerce ($299/mo)
#    - Google Ads Lead Generation ($350/mo)
#    - Google Ads for E-commerce ($400/mo)
#    - Meta & Google Growth Package ($999/mo)
#
# 2. Create one-time Prices for audits, setup, and consulting products listed in
#    `artifacts/marketing-portfolio/src/content/pricing-content.ts`.
#
# 3. Copy each Stripe Price ID (starts with `price_`) into the variables below.
#
# 4. Set these in Netlify: Site settings → Environment variables
#    (or in a local `.env` file when running `netlify dev`).
#
# NEVER commit your secret key or add STRIPE_SECRET_KEY to the frontend.
# =============================================================================

# Required (server-side only — Netlify Functions + optional local API server)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Optional webhook secret for future subscription lifecycle automation
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Monthly subscription Price IDs
STRIPE_PRICE_META_SERVICES=price_REPLACE_ME
STRIPE_PRICE_META_ECOMMERCE=price_REPLACE_ME
STRIPE_PRICE_GOOGLE_LEAD_GEN=price_REPLACE_ME
STRIPE_PRICE_GOOGLE_ECOMMERCE=price_REPLACE_ME
STRIPE_PRICE_GROWTH_PACKAGE=price_REPLACE_ME

# One-time payment Price IDs
STRIPE_PRICE_GOOGLE_ADS_AUDIT=price_REPLACE_ME
STRIPE_PRICE_META_ADS_AUDIT=price_REPLACE_ME
STRIPE_PRICE_CONVERSION_TRACKING_SETUP=price_REPLACE_ME
STRIPE_PRICE_GOOGLE_ADS_SETUP=price_REPLACE_ME
STRIPE_PRICE_META_ADS_SETUP=price_REPLACE_ME
STRIPE_PRICE_MERCHANT_CENTER_FIX=price_REPLACE_ME
STRIPE_PRICE_MERCHANT_CENTER_SUSPENSION=price_REPLACE_ME
STRIPE_PRICE_LANDING_PAGE_AUDIT=price_REPLACE_ME
STRIPE_PRICE_CONSULTING_5H=price_REPLACE_ME
STRIPE_PRICE_CONSULTING_10H=price_REPLACE_ME
STRIPE_PRICE_CONSULTING_20H=price_REPLACE_ME

# Local development (optional)
# API_URL=http://localhost:3001
# PORT=5000
